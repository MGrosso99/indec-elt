# =============================================================================
# Copiá este archivo a .env y completá los valores.  .env NUNCA va a git.
#   cp .env.example .env
# =============================================================================

# --- Versiones ---------------------------------------------------------------
AIRFLOW_VERSION=3.1.0
METABASE_VERSION=v0.65.4

# En Linux: el resultado de `id -u` (evita problemas de permisos en volúmenes)
AIRFLOW_UID=50000

# --- Postgres (superusuario, solo para init y postgres-exporter) -------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiame

# --- Base de metadata de Airflow ---------------------------------------------
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambiame

# --- Warehouse (Airbyte escribe en raw, dbt transforma) ----------------------
WAREHOUSE_DB_NAME=warehouse
WAREHOUSE_DB_USER=elt
WAREHOUSE_DB_PASSWORD=cambiame

# --- Metabase ----------------------------------------------------------------
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=cambiame
METABASE_READER_PASSWORD=cambiame     # usuario metabase_reader (solo lectura)

# --- Airflow -----------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiame
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# openssl rand -hex 32
AIRFLOW_JWT_SECRET=

# Conexión a la API de Airbyte (abctl expone http://localhost:8000).
# client_id / client_secret: `abctl local credentials` o la UI de Airbyte
# (Settings > Applications). Formato JSON (el formato URI deja el host sin http://):
AIRFLOW_CONN_AIRBYTE_DEFAULT='{"conn_type": "airbyte", "host": "http://host.docker.internal:8000/api/public/v1", "login": "CLIENT_ID", "password": "CLIENT_SECRET", "extra": {"token_url": "http://host.docker.internal:8000/api/public/v1/applications/token"}}'

# Alertas de Airflow a Slack (Incoming Webhook de #alertas-datos). Formato JSON:
AIRFLOW_CONN_SLACK_ALERTS='{"conn_type": "slackwebhook", "password": "https://hooks.slack.com/services/T000/B000/XXXX"}'

# Webhook completo de #alertas-datos, lo usa Elementary (edr monitor)
SLACK_WEBHOOK_URL=

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiame
